{
    "expo": {
        "name": "BarberSlot",
        "slug": "barberslot-mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/brand/logo.png",
        "scheme": "barberslot",
        "userInterfaceStyle": "automatic",
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "output": "static"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#0D0D0D",
                    "image": "./assets/images/brand/logo.png",
                    "imageWidth": 100
                }
            ],
            "expo-font"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}