# =========================================================
# BarberSlot - Git Ignore
# Repo: Web (Next.js) + Mobile (React Native / Expo)
# =========================================================


# -------------------------
# Dependencias
# -------------------------
**/node_modules/
**/.pnp
**/.pnp.*


# -------------------------
# Next.js
# -------------------------
**/.next/
**/out/


# -------------------------
# Build / production
# -------------------------
**/build/
**/dist/


# -------------------------
# Pruebas
# -------------------------
**/coverage/


# -------------------------
# Variables de Entorno
# -------------------------
**/.env
**/.env.*
!**/.env.example


# -------------------------
# Vercel
# -------------------------
**/.vercel/


# -------------------------
# TypeScript
# -------------------------
**/*.tsbuildinfo
**/next-env.d.ts


# -------------------------
# React Native / Expo
# -------------------------
**/.expo/
**/.expo-shared/
**/web-build/


# -------------------------
# Logs
# -------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log


# -------------------------
# Sistema Operativo
# -------------------------
.DS_Store
Thumbs.db


# -------------------------
# Certificados / Archivos Privados
# -------------------------
*.pem


# -------------------------
# IDE / Editor
# -------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
