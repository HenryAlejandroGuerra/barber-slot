{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,

        "paths": {
            "@/*": ["./src/*"]
        },

        "types": ["node"],
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "prisma/**/*.ts",
        "prisma.config.ts"
    ]
}
